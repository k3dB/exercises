# | Register | Usage     | Type    | Description                |
# | -------- | --------- | ------- | -------------------------- |
# | `$a0`    | input     | integer | input number               |
# | `$v0`    | output    | integer | number of eggs             |
# | `$t0-9`  | temporary | any     | used for temporary storage |

.globl egg_count

egg_count:
    move  $v0, $zero

_next:
    beqz  $a0, _done      # Any more one bits to count?
    andi  $t0, $a0, 1     # Get lowest bit value
    add   $v0, $v0, $t0   # Sum the bit values to count the ones
    srl   $a0, $a0, 1     # Move next bit to the lowest position
    j     _next

_done:
    jr    $ra
